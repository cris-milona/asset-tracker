{
  "name": "asset-tracker-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:setup": "psql -d asset_tracker -f src/db/schema.sql",
    "db:seed": "tsx src/db/seed.ts",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "express": "4.21.2",
    "pg": "8.13.1",
    "zod": "3.24.1",
    "dotenv": "16.4.7",
    "cors": "2.8.5"
  },
  "devDependencies": {
    "typescript": "5.7.2",
    "tsx": "4.19.2",
    "@types/express": "4.17.21",
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "@types/cors": "2.8.17",
    "vitest": "2.1.8",
    "eslint": "9.17.0",
    "@eslint/js": "9.17.0",
    "typescript-eslint": "8.18.2",
    "prettier": "3.4.2"
  }
}
